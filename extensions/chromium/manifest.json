{
  "manifest_version": 3,
  "name": "Nostr Portable Identity",
  "version": "0.1.0",
  "description": "Sign Nostr events using a portable USB vault",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["nostr-provider.js", "content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
